# AI Configuration
# Options: 'openai', 'anthropic', 'ollama', 'fake'
# - 'openai': Use OpenAI GPT models (requires OPENAI_API_KEY)
# - 'anthropic': Use Anthropic Claude models (requires ANTHROPIC_API_KEY)  
# - 'ollama': Use local Ollama installation (FREE, runs locally in Docker)
# - 'fake': Mock AI for testing/development (instant mock responses)
# Default for development: 'ollama' (no API costs!)
AI_PROVIDER=ollama

# API Keys (use AI_API_KEY for universal key, or specific provider keys)
AI_API_KEY=your_openai_or_anthropic_api_key_here
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# Ollama Configuration (automatically set up with npm run dev)
# No need to install Ollama locally - it runs in Docker!
# OLLAMA_BASE_URL is auto-configured to use the Docker container
OLLAMA_MODEL=phi4-mini:latest

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/contentworkflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=contentworkflow

# Application Configuration
NODE_ENV=development
PORT=8080

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080