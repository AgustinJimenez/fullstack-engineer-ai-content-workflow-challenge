# AI Configuration
AI_PROVIDER=openai
AI_API_KEY=your_openai_or_anthropic_api_key_here

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/contentworkflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=contentworkflow

# Application Configuration
NODE_ENV=development
PORT=8080

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional: Testing Configuration
USE_FAKE_AI=false

# Optional: Additional AI Provider Keys (if you want to switch between them)
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here