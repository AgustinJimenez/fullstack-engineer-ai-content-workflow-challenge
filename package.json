{
  "name": "ai-content-workflow-challenge",
  "version": "1.0.0",
  "description": "Fullstack AI Content Workflow Challenge",
  "scripts": {
    "dev": "docker compose -f compose.dev.yml up",
    "dev:simple": "docker compose -f compose.dev.yml up",
    "dev:prod": "docker compose up --build",
    "dev:local": "cd backend && npm run dev & cd frontend && npm run dev",
    "start": "docker compose up -d --build",
    "stop": "docker compose stop",
    "down": "docker compose down",
    "restart": "npm run stop && npm run start",
    "reset-db": "docker compose down -v && docker compose up -d --build",
    "clean": "docker compose down -v && docker system prune -f",
    "logs": "docker compose logs -f",
    "logs:backend": "docker compose logs -f backend",
    "logs:frontend": "docker compose logs -f frontend",
    "logs:db": "docker compose logs -f db",
    "test": "npm run test:api && npm run test:e2e",
    "test:api": "cd backend && npm test",
    "test:e2e": "./scripts/test-setup.sh && AI_PROVIDER=fake playwright test --workers=1",
    "test:e2e:debug": "./scripts/test-setup.sh && AI_PROVIDER=fake playwright test --workers=1 --headed --debug",
    "test:e2e:ui": "./scripts/test-setup.sh && AI_PROVIDER=fake playwright test --ui",
    "test:e2e:headed": "./scripts/test-setup.sh && AI_PROVIDER=fake playwright test --headed --workers=1",
    "test:e2e:junit": "./scripts/test-setup.sh && AI_PROVIDER=fake playwright test --workers=1 --reporter=junit",
    "test:e2e:json-only": "./scripts/test-setup.sh && AI_PROVIDER=fake playwright test --workers=1 --config=playwright-json-only.config.ts",
    "test:e2e:html": "./scripts/test-setup.sh && AI_PROVIDER=fake playwright test --workers=1 --reporter=html",
    "test:e2e:fake": "./scripts/test-setup.sh && AI_PROVIDER=fake playwright test --workers=1",
    "test:e2e:fake:single": "./scripts/test-setup.sh && AI_PROVIDER=fake playwright test --workers=1",
    "test:e2e:fake:fast": "./scripts/test-setup.sh && AI_PROVIDER=fake playwright test --workers=1 --config=playwright-json-only.config.ts --reporter=line",
    "install:all": "cd backend && npm install && cd ../frontend && npm install",
    "build": "cd backend && npm run build && cd ../frontend && npm run build",
    "seed": "docker exec ai-content-backend npx ts-node src/seeders/index.ts",
    "seed:clear": "docker exec ai-content-backend npx ts-node src/seeders/index.ts --clear",
    "seed:small": "docker exec ai-content-backend npx ts-node src/seeders/index.ts --count=100",
    "seed:large": "docker exec ai-content-backend npx ts-node src/seeders/index.ts --count=5000",
    "test:setup": "./scripts/test-setup.sh",
    "dev:restore": "./scripts/dev-restore.sh",
    "ollama:setup": "./scripts/ollama-setup.sh",
    "ollama:pull": "docker exec ai-content-ollama ollama pull",
    "ollama:list": "docker exec ai-content-ollama ollama list",
    "ollama:shell": "docker exec -it ai-content-ollama /bin/bash"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@playwright/test": "^1.40.0",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "playwright": "^1.40.0"
  }
}
