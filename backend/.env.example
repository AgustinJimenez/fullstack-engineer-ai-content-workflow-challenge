# AI Content Workflow Backend - Environment Configuration
# Copy this file to .env and update with your actual values

# ================================
# APPLICATION SETTINGS
# ================================
NODE_ENV=development
PORT=8080
APP_VERSION=1.0.0-dev

# ================================
# DATABASE CONFIGURATION
# ================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_content_workflow
DB_USER=postgres
DB_PASS=postgres
DB_SSL=false

# Database connection pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT=60000

# Test database (used by test suites)
TEST_DB_NAME=ai_content_test

# ================================
# FRONTEND INTEGRATION
# ================================
FRONTEND_URL=http://localhost:3000

# CORS settings
ENABLE_CORS=true
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ================================
# AI SERVICE CONFIGURATION
# ================================
# OpenAI API Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

# Anthropic API Configuration  
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-sonnet-20240229
ANTHROPIC_MAX_TOKENS=2000

# AI Service Settings
AI_TIMEOUT=30000
AI_RATE_LIMIT=60
USE_FAKE_AI=false
USE_FAKE_AI_IN_TESTS=true

# ================================
# LOGGING & DEBUGGING
# ================================
LOG_LEVEL=debug
ENABLE_REQUEST_LOGGING=true

# ================================
# DEVELOPMENT TOOLS
# ================================
# GraphQL Playground (auto-disabled in production)
ENABLE_GRAPHQL_PLAYGROUND=true

# Enable hot reload and TypeScript compilation
USE_TS_NODE=true
WATCH_FILES=true

# ================================
# MONITORING & HEALTH CHECKS
# ================================
ENABLE_METRICS=true
HEALTH_CHECK_ENABLED=true
ENABLE_DETAILED_HEALTH_CHECKS=true

# ================================
# SECURITY SETTINGS
# ================================
# Future authentication settings
# JWT_SECRET=your-super-secret-jwt-signing-key
# JWT_EXPIRES_IN=24h

# API Rate limiting (requests per minute)
API_RATE_LIMIT=1000

# Helmet security headers
HELMET_CSP_ENABLED=true

# ================================
# EXTERNAL MONITORING SERVICES
# ================================
# Uncomment and configure if using external monitoring

# Sentry Error Tracking
# SENTRY_DSN=https://your-sentry-dsn-here

# New Relic APM
# NEW_RELIC_LICENSE_KEY=your-newrelic-license-key
# NEW_RELIC_APP_NAME=ai-content-workflow-backend

# ================================
# LANGCHAIN CONFIGURATION
# ================================
# LangChain specific settings for advanced AI workflows
LANGCHAIN_VERBOSE=false
LANGCHAIN_CACHE_ENABLED=true

# ================================
# CACHE CONFIGURATION (Future)
# ================================
# Redis settings (when implemented)
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=
# REDIS_DB=0
# CACHE_TTL=3600

# ================================
# MESSAGE QUEUE (Future)
# ================================
# When async processing is implemented
# QUEUE_URL=redis://localhost:6379
# QUEUE_JOB_CONCURRENCY=5
# QUEUE_JOB_ATTEMPTS=3

# ================================
# FILE STORAGE (Future)
# ================================
# When file upload features are added
# STORAGE_TYPE=local
# STORAGE_PATH=./uploads
# AWS_S3_BUCKET=ai-content-uploads
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# ================================
# EMAIL SETTINGS (Future)
# ================================
# When notification features are added
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# FROM_EMAIL=noreply@yourcompany.com

# ================================
# BUILD & DEPLOYMENT INFO
# ================================
# These are typically set by CI/CD systems
# BUILD_TIMESTAMP=2024-01-01T12:00:00Z
# GIT_COMMIT=abc123def456
# GIT_BRANCH=main

# ================================
# DEVELOPMENT NOTES
# ================================
# 1. Never commit this file with real secrets to version control
# 2. For production, use proper secrets management (Kubernetes secrets, etc.)
# 3. AI API keys are required for full functionality - set USE_FAKE_AI=true for testing
# 4. Database must be running and accessible for the application to start
# 5. Check the documentation for environment-specific configurations