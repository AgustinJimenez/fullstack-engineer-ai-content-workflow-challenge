{
  "name": "ai-content-backend",
  "version": "1.0.0",
  "description": "AI Content Workflow Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --config=jest.unit.config.js",
    "test:integration": "jest --testPathPattern=integration",
    "check-config": "node scripts/check-config.js",
    "seed": "ts-node src/seeders/index.ts",
    "seed:clear": "ts-node src/seeders/index.ts --clear",
    "seed:small": "ts-node src/seeders/index.ts --count=100",
    "seed:large": "ts-node src/seeders/index.ts --count=5000"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.63.0",
    "@langchain/anthropic": "^0.3.28",
    "@langchain/core": "^0.3.77",
    "@langchain/openai": "^0.6.13",
    "@types/graphql": "^14.5.0",
    "apollo-server-express": "^3.13.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "graphql": "^16.11.0",
    "graphql-scalars": "^1.24.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "openai": "^4.20.1",
    "pg": "^8.11.3",
    "redis": "^4.7.1",
    "reflect-metadata": "^0.1.13",
    "sequelize": "^6.35.1",
    "sequelize-typescript": "^2.1.5",
    "type-graphql": "^2.0.0-rc.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@testcontainers/postgresql": "^10.4.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.9.0",
    "@types/pg": "^8.10.7",
    "@types/redis": "^4.0.11",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  }
}
